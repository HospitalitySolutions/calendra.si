{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyCalendraStagingSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:eu-central-1:REPLACE_ACCOUNT_ID:secret:calendra-staging-*"
    }
  ]
}
