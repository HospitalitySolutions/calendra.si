# Copy to .env.staging on the staging EC2 server.
# This file contains bootstrap/deployment values only. Application credentials and
# environment-specific URLs belong in the calendra-staging AWS Secrets Manager JSON.

AWS_REGION=eu-central-1
AWS_STAGING_SECRET_ID=calendra-staging

# Always deploy an immutable full Git SHA published by GitHub Actions.
CALENDRA_IMAGE_REGISTRY=ghcr.io/hospitalitysolutions
CALENDRA_IMAGE_TAG=replace-with-full-git-sha

# Optional container sizing overrides.
BACKEND_MEMORY_LIMIT=2g
BACKEND_CPU_LIMIT=2.0
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=0.5
