:80 {
	encode gzip
	root * /usr/share/caddy

	# Transactional application routes should be crawlable so search engines can
	# see the noindex directive, but they must not appear in search results.
	# Keep /narocanje itself indexable; only tenant booking flows are excluded.
	@noindex_routes path /login /signup /signup/* /narocanje/*
	header @noindex_routes X-Robots-Tag "noindex, follow"

	# Vite build assets use content hashes in their filenames. Serve them as
	# immutable files, and importantly: never fall back to index.html when an
	# asset is missing. Returning index.html for a missing .js file produces a
	# text/html response and browsers reject it as a module script.
	@vite_assets path /assets/*
	handle @vite_assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA routes still fall back to index.html. Do not cache these responses so
	# a deployment cannot leave the browser pointing at hashed assets from the
	# previous frontend build.
	handle {
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Pragma "no-cache"
		header Expires "0"
		try_files {path} /index.html
		file_server
	}
}
